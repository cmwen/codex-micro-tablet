<?xml version="1.0" encoding="utf-8"?>
<!-- User-configured FNK0104B LAN bridges support HTTP. The app validates addresses
     and requires explicit setup; bridge credentials must stay on trusted networks. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors><certificates src="system"/></trust-anchors>
    </base-config>
</network-security-config>
