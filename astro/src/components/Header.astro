---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [['/', 'Home'], ['/about/', 'About'], ['/install/', 'Install'], ['/releases/', 'Releases']];
---
<header class="site-title">
  <div class="brand">CODEX / MICRO</div>
  <p class="lead">Your Android tablet, connected to your Codex desk.</p>
  <nav class="nav" aria-label="Main navigation">
    {links.map(([path, label]) => <a href={`${base}${path}`} aria-current={Astro.url.pathname === `${base}${path}` ? 'page' : undefined}>{label}</a>)}
    <a href="https://github.com/cmwen/codex-micro-tablet" target="_blank" rel="noopener">Repository ↗</a>
  </nav>
</header>
